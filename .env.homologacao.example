# Aplicacao
APP_ENV=staging
APP_DEBUG=false
APP_URL=https://homologacao.seudominio.com.br
ALLOWED_ORIGINS=https://homologacao.seudominio.com.br

# Chave interna obrigatoria para /api/sync_assets.php
SYNC_ASSETS_KEY=troque-por-chave-forte

# MySQL ficticio. O sistema atual grava a conexao efetiva em config/database.php.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hospedagem_homologacao
DB_USERNAME=hospedagem_hml
DB_PASSWORD=troque-por-senha-forte

# Mercado Pago sandbox. O token efetivo e configurado no painel e salvo no banco.
MERCADO_PAGO_ENV=sandbox
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=

# Evolution API normal. Manter URL/chave ficticias ate configurar a homologacao.
EVOLUTION_BASE_URL=https://sua-evolution-api-hml.example.com

EVOLUTION_API_KEY=troque-pela-chave-global-da-evolution

# A instancia e criada e salva automaticamente pelo painel admin.
# Nao preencha manualmente, a menos que queira reaproveitar uma instancia ja existente.
# EVOLUTION_INSTANCE=
